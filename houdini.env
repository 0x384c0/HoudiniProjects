#
# NOTE: The use of packages is highly recommended instead of houdini.env 
# See details about packages here: https://www.sidefx.com/docs/houdini22.0/ref/plugins.html
#
# Houdini Environment Settings
#
# The contents of this file are read into the environment
# at startup.  They will override any existing entries in
# the environment.
#
# The syntax is one entry per line as follows:
#    VAR = VALUE
#
# Values may be quoted
#    VAR = "VALUE"
#
# Values may be empty
#    VAR = 
#

# Example:
#
# HOUDINI_NO_SPLASH = 1


# Houdini
HOUDINI_CONSOLE_LINES = 1024
HOUDINI_MAX_BACKUP_FILES = 32
EDITOR = "$LOCALAPPDATA\Programs\Microsoft VS Code\Code.exe"
HOUDINI_TEXTURE_DISK_CACHE = temp

# Karma XPU - raise UDIM tile limits
KARMA_XPU_MAX_UDIM_U = 10
KARMA_XPU_MAX_UDIM_V = 100


